        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Estilos Generales\n    classDef internet fill:#f9f,stroke:#333,stroke-width:2px;\n    classDef central fill:#bbf,stroke:#333,stroke-width:2px;\n    classDef sucursal fill:#bfb,stroke:#333,stroke-width:2px;\n    classDef equipos fill:#fff,stroke:#333,stroke-width:1px;\n\n    subgraph Internet_Cloud [Nube de Internet]\n        ISP[Proveedor ISP Central]:::internet\n    end\n    \n    subgraph Central [Edificio Central - Subsuelo Data Center]\n        R_Central[Router MikroTik Principal]:::central\n        SW_L3[Switch Capa 3 - Enrutamiento Inter-VLAN]:::central\n        SW_L2_DC[Switch Capa 2 - Distribución Servidores]:::central\n        Servidores[(Servidores Core: DHCP, DNS, LDAP, Proxy Squid, SMTP)]:::equipos\n    end\n\n    subgraph Pisos [Edificio Central - Oficinas Administrativas Pisos 1 y 2]\n        SW_Piso1[Switch Capa 2 - Distribución Piso 1]:::central\n        SW_Piso2[Switch Capa 2 - Distribución Piso 2]:::central\n        AP_Admin[AP Wi-Fi Administración - Autenticación 802.1X]:::equipos\n        SUM_AP[AP Wi-Fi SUM - Portal Cautivo Hotspot]:::equipos\n        Admin_PCs[3 PCs por Sector: Ventas, Compras, Contaduría, Tesorería, Soporte]:::equipos\n    end\n\n    subgraph Colectora [Sucursal Colectora Norte - Galpón 10x50m]\n        R_Colectora[Router MikroTik Local]:::sucursal\n        SW_Colectora[Switch Capa 2 Acceso]:::sucursal\n        Cajas_Col[8 Cajas de Cobro Cableadas + PC Administración]:::equipos\n    end\n\n    subgraph Vela_Suc [Sucursal Vela - Galpón 10x20m]\n        R_Vela[Router MikroTik Local]:::sucursal\n        SW_Vela[Switch Capa 2 Acceso]:::sucursal\n        Cajas_Vela[3 Cajas de Cobro Cableadas + PC Administración]:::equipos\n    end\n\n    %% Conexiones Físicas y Lógicas Core Central\n    ISP --- R_Central\n    [span_0](start_span)R_Central --- SW_L3[span_0](end_span)\n    [span_1](start_span)SW_L3 --- SW_L2_DC[span_1](end_span)\n    [span_2](start_span)SW_L2_DC --- Servidores[span_2](end_span)\n    \n    %% Cableado Vertical y Horizontal de la Central\n    SW_L3 --- |Fibra Óptica Multimodo Backbone vertical| [span_3](start_span)[span_4](start_span)SW_Piso1[span_3](end_span)[span_4](end_span)\n    SW_L3 --- |Fibra Óptica Multimodo Backbone vertical| [span_5](start_span)[span_6](start_span)SW_Piso2[span_5](end_span)[span_6](end_span)\n    SW_Piso1 --- |Cableado UTP Cat6 Horizontal| [span_7](start_span)[span_8](start_span)Admin_PCs[span_7](end_span)[span_8](end_span)\n    [span_9](start_span)SW_Piso1 --- AP_Admin[span_9](end_span)\n    [span_10](start_span)[span_11](start_span)SW_Piso2 --- SUM_AP[span_10](end_span)[span_11](end_span)\n\n    %% Enlaces WAN hacia Sucursales Periféricas\n    R_Central === |Enlace Principal: Fibra Óptica ISP FTTx| [span_12](start_span)R_Colectora[span_12](end_span)\n    R_Central -.- |Enlace Respaldo: Radioenlace WISP| [span_13](start_span)R_Colectora[span_13](end_span)\n    R_Central ==&gt; |Túnel Cifrado VPN sobre Banda Ancha| [span_14](start_span)[span_15](start_span)R_Vela[span_14](end_span)[span_15](end_span)\n\n    %% Redes Internas de las Sucursales\n    [span_16](start_span)R_Colectora --- SW_Colectora[span_16](end_span)\n    SW_Colectora --- |VLAN Cajas + VLAN Admin| [span_17](start_span)[span_18](start_span)Cajas_Col[span_17](end_span)[span_18](end_span)\n    [span_19](start_span)R_Vela --- SW_Vela[span_19](end_span)\n    SW_Vela --- |VLAN Cajas + VLAN Admin| [span_20](start_span)[span_21](start_span)Cajas_Vela[span_20](end_span)[span_21](end_span)\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9zjbwiLizRp2Y1zd26qU-1">
