node n1 {
    type router
    model router
    network-config {
        hostname Frontera
        !
        interface eth3
         ip address 192.168.1.1/24
        !
        interface eth2
         ip address 192.168.0.1/24
        !
        interface eth1
         ip address 10.0.1.2/24
        !
    }
    canvas c1
    iconcoords {393.0 188.0}
    labelcoords {393.0 220.0}
    interface-peer {eth1 n3}
    interface-peer {eth2 n6}
    interface-peer {eth3 n7}
    services {IPForward UserDefined}
    custom-config {
        custom-config-id service:UserDefined
        custom-command UserDefined
        config {
        cmdup=('ip route add default via 10.0.1.1', )
        }
    }
}


node n3 {
    type router
    model router
    network-config {
        hostname ISP2
        !
        interface eth3
         ip address 10.0.4.1/24
         ipv6 address 2001:0::1/64
        !
        interface eth2
         ip address 10.0.6.1/24
        !
        interface eth1
         ip address 10.0.3.1/24
        !
        interface eth0
         ip address 10.0.1.1/24
        !
    }
    canvas c1
    iconcoords {244.0 249.0}
    labelcoords {244.0 281.0}
    interface-peer {eth0 n1}
    interface-peer {eth1 n5}
    interface-peer {eth2 n13}
    services {IPForward}
    interface-peer {eth3 n4}
}


node n4 {
    type router
    model host
    network-config {
        hostname SSH
        !
        interface eth1
         ip address 10.0.4.10/24
         ipv6 address 2001:0::10/64
        !
    }
    canvas c1
    iconcoords {145.0 82.0}
    labelcoords {145.0 114.0}
    services {DefaultRoute SSH}
    interface-peer {eth1 n3}
}


node n5 {
    type router
    model host
    network-config {
        hostname Web
